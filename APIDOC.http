
# ============ MealMate ============

# 1. Register user
###
POST http://127.0.0.1:8000/mealplanner/register/
Content-Type: application/json

{
    "username": "sooraj",
    "email": "sooraj@gmail.com",
    "password": "sooraj123"
}


# 2. Generate token
###
POST http://127.0.0.1:8000/mealplanner/token/
Content-Type: application/json

{
    "username": "sooraj",
    "password": "sooraj123"
}


# 3. Get logged-in user
###
GET http://127.0.0.1:8000/mealplanner/me/
Accept: application/json
Authorization: Token bc829e97d6b21ff97c67c9fb4fe3f1a32acfbd09


# 4. List FoodLog
###
GET http://127.0.0.1:8000/mealplanner/foodlog/
Accept: application/json
Authorization: Token bc829e97d6b21ff97c67c9fb4fe3f1a32acfbd09


# 5. Create FoodLog
###
POST http://127.0.0.1:8000/mealplanner/foodlog/
Content-Type: application/json
Authorization: Token bc829e97d6b21ff97c67c9fb4fe3f1a32acfbd09

{
    "title": "Snacks",
    "calorie": 400,
    "meal_type": "SNACKS",
    "serving_size": "150 gm"
}


# 6. Retrieve one FoodLog
###
GET http://127.0.0.1:8000/mealplanner/foodlog/1/
Accept: application/json
Authorization: Token bc829e97d6b21ff97c67c9fb4fe3f1a32acfbd09


# 7. Update FoodLog
###
PUT http://127.0.0.1:8000/mealplanner/foodlog/1/
Content-Type: application/json
Authorization: Token bc829e97d6b21ff97c67c9fb4fe3f1a32acfbd09

{
    "title": "Puffs",
    "calorie": 200,
    "meal_type": "SNACKS",
    "serving_size": "150 gm"
}


# 8. Delete FoodLog
###
DELETE http://127.0.0.1:8000/mealplanner/foodlog/5/
Authorization: Token bc829e97d6b21ff97c67c9fb4fe3f1a32acfbd09


# 9. FoodLog Summary
###
GET http://127.0.0.1:8000/mealplanner/foodlog/summary/
Accept: application/json
Authorization: Token bc829e97d6b21ff97c67c9fb4fe3f1a32acfbd09


# 10. Generate Diet Plan
###
GET http://127.0.0.1:8000/mealplanner/foodlog/diet/
Accept: application/json
Authorization: Token bc829e97d6b21ff97c67c9fb4fe3f1a32acfbd09


